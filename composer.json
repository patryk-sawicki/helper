{
  "name": "patryk-sawicki/helper",
  "description": "A set of helpful tools for PHP.",
  "license": "MIT",
  "authors": [
    {
      "name": "Patryk Sawicki",
      "email": "patryk@patryksawicki.pl"
    }
  ],
  "autoload": {
    "psr-4": {
      "PatrykSawicki\\Helper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PatrykSawicki\\Helper\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "intervention/image": "^3.5",
    "laravel/framework": "^11.00 || ^12.00 || ^13.00"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "PatrykSawicki\\Helper\\app\\Providers\\HelperServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
